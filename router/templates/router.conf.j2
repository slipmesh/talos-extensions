{#- bird_exporter reads a protocol's "Since" field to compute uptime; it only parses this
     format, not BIRD's default. -#}
timeformat protocol iso long;
log stderr { info, remote, warning, error, auth, fatal, bug };
router id {{ loopback }};
{%- set egress_table = classes.egress.table if classes.egress is defined else none %}
{%- set egress_community = "(" ~ as_number ~ ", " ~ egress_table ~ ", 0)" %}
{%- set roadwarrior_route_protocol = 151 %}
{#- Above BGP's 100: another exit node's path stays out of the egress table. #}
{%- set egress_route_preference = 200 %}
{%- if egress_table is not none %}
ipv4 table egress4;
ipv6 table egress6;
{%- endif %}
protocol device {
}
protocol direct direct1 {
    interface "{{ router_loopback_iface }}";
    ipv4 { import all; };
}
{%- for iface in direct_interfaces %}
protocol direct direct_{{ iface.protocol_id }} {
    interface {{ iface.pattern }};
    ipv4 { import all; };
}
{%- endfor %}
{#- A pool runs on several nodes under one address: a client's route tells the others which
     node it is on. #}
protocol kernel {
    ipv4 {
        import filter {
{%- if learn %}
            if net ~ [ {{ learn|join(", ") }} ] then accept;
{%- endif %}
            if krt_source = {{ awg_route_protocol }} then accept;
            if krt_source = {{ roadwarrior_route_protocol }} then accept;
            reject;
        };
        export filter {
            if source = RTS_BGP then {
{%- if egress_table is not none %}
                if {{ egress_community }} ~ bgp_large_community then reject;
{%- endif %}
                krt_prefsrc = {{ loopback }};
                accept;
            }
            if proto = "ANNOUNCE" then {
                krt_prefsrc = {{ loopback }};
                accept;
            }
            reject;
        };
    };
{%- if learn %}
    learn all;
{%- else %}
    learn;
{%- endif %}
}
protocol kernel {
    ipv6 {
        export filter {
            if source = RTS_OSPF then accept;
            reject;
        };
    };
}
{%- if egress_table is not none %}
{#- BIRD allows one kernel protocol per table. -#}
{%- for family in [4, 6] %}
protocol pipe {
    table master{{ family }};
    peer table egress{{ family }};
    import filter {
        if source = RTS_INHERIT then accept;
        reject;
    };
    export filter {
        if source = RTS_BGP && {{ egress_community }} ~ bgp_large_community then accept;
        reject;
    };
}
protocol kernel kernel_egress{{ family }} {
    kernel table {{ egress_table }};
    learn;
    ipv{{ family }} {
        table egress{{ family }};
        import filter {
            if krt_source = {{ classes.egress.protocol }} then {
                preference = {{ egress_route_preference }};
                accept;
            }
            reject;
        };
        export filter {
            krt_prefsrc = {{ loopback if family == 4 else ipv6_loopback }};
            accept;
        };
    };
}
{%- endfor %}
{%- endif %}
{%- if bfd %}
{#- BIRD's defaults (min tx 100 ms, multiplier 5) declare a session dead after ~500 ms, which
     these links cannot honour: every mesh interface is an obfuscated WireGuard tunnel, several of
     them intercontinental, where a brief stall is normal and a flap costs more than slow
     convergence. 300 ms with the default multiplier detects in ~1.5s against OSPF's 40s dead
     timer - and a timer is the only signal available, since a WireGuard interface stays up
     whether or not packets still cross it. -#}
protocol bfd {
{%- for iface in ospf_interfaces %}
{%- if iface.bfd %}
    interface {{ iface.pattern }} {
        min rx interval {{ bfd.min_rx_ms }} ms;
        min tx interval {{ bfd.min_tx_ms }} ms;
        multiplier {{ bfd.multiplier }};
    };
{%- endif %}
{%- endfor %}
}
{%- endif %}
protocol ospf v3 mesh6 {
    ipv6 {
        import all;
        export none;
    };
    area 0 {
        interface "{{ router_loopback_iface }}" { stub yes; };
{%- for iface in ospf_interfaces %}
        interface {{ iface.pattern }} { type ptp;{% if iface.bfd %} bfd on;{% endif %} };
{%- endfor %}
    };
}
{%- if bypass %}
protocol static BYPASS {
    ipv4 { import all; };
{%- for r in bypass %}
    route {{ r.net }} blackhole; # {{ r.label }}
{%- endfor %}
}
{%- endif %}
{%- if announce %}
protocol static ANNOUNCE {
    ipv4 { import all; };
{%- for r in announce %}
    route {{ r.net }} via "{{ router_loopback_iface }}"; # {{ r.label }}
{%- endfor %}
}
{%- endif %}
{%- for peer in bgp_peers %}
protocol bgp ibgp6_{{ peer.protocol_id }} {
    local {{ ipv6_loopback }} as {{ as_number }};
    neighbor {{ peer.address }} as {{ as_number }};
    multihop;
    ipv4 {
        extended next hop on;
        import all;
        export filter {
            if source = RTS_DEVICE then accept;
{%- if egress_table is not none %}
            if proto = "BYPASS" || proto = "kernel_egress4" then {
                bgp_large_community.add({{ egress_community }});
                accept;
            }
{%- endif %}
            if source = RTS_STATIC then accept;
            if source = RTS_INHERIT then accept;
            reject;
        };
        next hop self;
    };
    ipv6 {
        import all;
{%- if egress_table is not none %}
        export filter {
            if proto = "kernel_egress6" then {
                bgp_large_community.add({{ egress_community }});
                accept;
            }
            reject;
        };
{%- else %}
        export none;
{%- endif %}
        next hop self;
    };
}
{%- endfor %}
