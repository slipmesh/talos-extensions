{#- bird_exporter reads a protocol's "Since" field to compute uptime; it only parses this
     format, not BIRD's default. -#}
timeformat protocol iso long;
log stderr { info, remote, warning, error, auth, fatal, bug };
router id {{ loopback }};
protocol device {
}
protocol direct direct1 {
    interface "{{ router_loopback_iface }}";
    ipv4 { import all; };
}
{%- for iface in direct_interfaces %}
protocol direct direct_{{ iface.protocol_id }} {
    interface {{ iface.pattern }};
    ipv4 { import all; };
}
{%- endfor %}
{#- awg tags the routes of the roadwarrior clients it holds with a protocol number of its own. A
     pool runs on several nodes under one address, so the route is what tells the others which
     node a client is connected to. #}
protocol kernel {
    ipv4 {
        import filter {
{%- if learn %}
            if net ~ [ {{ learn|join(", ") }} ] then accept;
{%- endif %}
            if krt_source = {{ awg_route_protocol }} then accept;
            reject;
        };
        export filter {
            if source = RTS_BGP then {
                krt_prefsrc = {{ loopback }};
                accept;
            }
            if proto = "ANNOUNCE" then {
                krt_prefsrc = {{ loopback }};
                accept;
            }
            reject;
        };
    };
{%- if learn %}
    learn all;
{%- else %}
    learn;
{%- endif %}
}
protocol kernel {
    ipv6 {
        export filter {
            if source = RTS_OSPF then accept;
            reject;
        };
    };
}
{%- if bfd %}
{#- BIRD's defaults (min tx 100 ms, multiplier 5) declare a session dead after ~500 ms, which
     these links cannot honour: every mesh interface is an obfuscated WireGuard tunnel, several of
     them intercontinental, where a brief stall is normal and a flap costs more than slow
     convergence. 300 ms with the default multiplier detects in ~1.5s against OSPF's 40s dead
     timer - and a timer is the only signal available, since a WireGuard interface stays up
     whether or not packets still cross it. -#}
protocol bfd {
{%- for iface in ospf_interfaces %}
{%- if iface.bfd %}
    interface {{ iface.pattern }} {
        min rx interval {{ bfd.min_rx_ms }} ms;
        min tx interval {{ bfd.min_tx_ms }} ms;
        multiplier {{ bfd.multiplier }};
    };
{%- endif %}
{%- endfor %}
}
{%- endif %}
protocol ospf v3 mesh6 {
    ipv6 {
        import all;
        export none;
    };
    area 0 {
        interface "{{ router_loopback_iface }}" { stub yes; };
{%- for iface in ospf_interfaces %}
        interface {{ iface.pattern }} { type ptp;{% if iface.bfd %} bfd on;{% endif %} };
{%- endfor %}
    };
}
{%- if bypass %}
protocol static BYPASS {
    ipv4 { import all; };
{%- for r in bypass %}
    route {{ r.net }} blackhole; # {{ r.label }}
{%- endfor %}
}
{%- endif %}
{%- if announce %}
protocol static ANNOUNCE {
    ipv4 { import all; };
{%- for r in announce %}
    route {{ r.net }} via "{{ router_loopback_iface }}"; # {{ r.label }}
{%- endfor %}
}
{%- endif %}
{%- for peer in bgp_peers %}
protocol bgp ibgp6_{{ peer.protocol_id }} {
    local {{ ipv6_loopback }} as {{ as_number }};
    neighbor {{ peer.address }} as {{ as_number }};
    multihop;
    ipv4 {
        extended next hop on;
        import all;
        export filter {
            if source = RTS_DEVICE then accept;
            if source = RTS_STATIC then accept;
            if source = RTS_INHERIT then accept;
            reject;
        };
        next hop self;
    };
}
{%- endfor %}
